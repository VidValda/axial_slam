Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 60
      Color: 80; 80; 80
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Mask clusters
      Enabled: true
      Topic:
        Value: /axial/mask_clusters
        Reliability Policy: Reliable
        Depth: 5
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 5
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Cluster labels
      Enabled: true
      Topic:
        Value: /axial/mask_cluster_markers
        Reliability Policy: Reliable
        Depth: 5
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Landmark map
      Enabled: true
      Topic:
        Value: /axial/landmark_map
        Reliability Policy: Reliable
        Depth: 1
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Landmark axes
      Enabled: true
      Topic:
        Value: /axial/landmark_markers
        Reliability Policy: Reliable
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Overlay
      Enabled: true
      Topic:
        Value: /axial/mask_overlay
        Reliability Policy: Reliable
        Depth: 5
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
      Distance: 10
      Pitch: 0.6
      Yaw: 3.4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Value: Orbit (rviz)
    Saved: ~
